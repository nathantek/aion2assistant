<Window x:Class="Aion2Assistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aion2Assistant.App.ViewModels"
        xmlns:views="clr-namespace:Aion2Assistant.App.Views"
        Title="Aion2Assistant"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="0" Top="0" Width="320" Height="260"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MeterViewModel}">
            <views:MeterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimersViewModel}">
            <views:TimersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="8" Background="{DynamicResource OverlayBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
        <Grid Effect="{DynamicResource TextOutlineEffect}">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="TabBar" Grid.Row="0" Margin="4,0" Background="Transparent"
                       MouseLeftButtonDown="OnTabBarMouseDown">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="16" Margin="4,0,6,0" Fill="{DynamicResource DividerBrush}"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{Binding Capture.IndicatorBrush}" ToolTip="{Binding Capture.StatusText}"/>
                    <Button Command="{Binding ToggleDockCommand}" ToolTip="Ancrer / libérer (Ctrl+Alt+Num7)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Content" Value="&#xE77A;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDocked}" Value="True">
                                        <Setter Property="Content" Value="&#xE718;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE921;"
                            Command="{Binding ToggleMinimizeCommand}" ToolTip="Réduire / agrandir (Ctrl+Alt+Num8)"/>
                    <RadioButton Style="{StaticResource ClusterTabButtonStyle}" Content="&#xE713;" ToolTip="Réglages"
                                 IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OverlayTab.Settings}}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:OverlayTab.Settings}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabButtonStyle}" Content="{StaticResource Icon.Sword}" Tag="{DynamicResource DpsBrush}"
                                 ToolTip="DPS (Ctrl+Alt+Num1)"
                                 IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OverlayTab.Dps}}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:OverlayTab.Dps}"/>
                    <RadioButton Style="{StaticResource TabButtonStyle}" Content="{StaticResource Icon.Shield}" Tag="{DynamicResource TakenBrush}"
                                 ToolTip="Dégâts reçus (Ctrl+Alt+Num2)"
                                 IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OverlayTab.Taken}}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:OverlayTab.Taken}"/>
                    <RadioButton Style="{StaticResource TabButtonStyle}" Content="{StaticResource Icon.Heart}" Tag="{DynamicResource HealBrush}"
                                 ToolTip="Soins (Ctrl+Alt+Num3)"
                                 IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OverlayTab.Heal}}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:OverlayTab.Heal}"/>
                    <RadioButton Style="{StaticResource TabButtonStyle}" Content="{StaticResource Icon.History}" Tag="{DynamicResource TextBrush}"
                                 ToolTip="Historique (Ctrl+Alt+Num4)"
                                 IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OverlayTab.History}}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:OverlayTab.History}"/>
                    <RadioButton Style="{StaticResource TabButtonStyle}" Content="{StaticResource Icon.Hourglass}" Tag="{DynamicResource TimerBrush}"
                                 ToolTip="Timers (Ctrl+Alt+Num5)"
                                 IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OverlayTab.Timers}}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:OverlayTab.Timers}"/>
                </StackPanel>
                <TextBlock Text="{Binding MiniValueText}" Foreground="{Binding MiniValueBrush}"
                           ToolTip="{Binding MiniValueTip}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" HorizontalAlignment="Right"
                           Visibility="{Binding MiniValueText, Converter={StaticResource NullToCollapsed}}"/>
            </DockPanel>

            <Border Grid.Row="1" Margin="8,0,8,6" Padding="8,6" CornerRadius="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AlertBrush}" BorderThickness="2,0,0,0"
                    Visibility="{Binding WarningMessage, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                            Command="{Binding DismissWarningCommand}" ToolTip="Fermer"/>
                    <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"/>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="2" Margin="10,0,10,10" Content="{Binding CurrentPage}"
                            Visibility="{Binding IsMinimized, Converter={StaticResource InverseBoolToVisibility}}"/>
        </Grid>
    </Border>
</Window>
