<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Aion2Assistant</AssemblyName>
    <RootNamespace>Aion2Assistant.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icône de l'exe : reprise par les raccourcis créés à l'installation et par la barre des tâches. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Le DPI (PerMonitorV2) est déclaré dans le manifeste pour WPF ; WinForms n'héberge que le NotifyIcon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.4.1</Version>
    <InformationalVersion>0.4.1-beta.1</InformationalVersion>
    <!-- Point d'entrée explicite (Program.Main dans App.xaml.cs) : Velopack doit s'exécuter avant tout. -->
    <StartupObject>Aion2Assistant.App.App</StartupObject>
    <!-- Ressources neutres en anglais (Localization/UiStrings.resx) ; le français va dans l'assembly satellite fr\. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms ne sert qu'à l'icône de la zone de notification : on retire ses usings globaux, qui entreraient en conflit avec WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- Le SDK WPF retire System.IO des usings implicites (conflit avec System.Windows.Shapes.Path) : on le remet. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Velopack" Version="[1.2.161]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aion2Assistant.Core\Aion2Assistant.Core.csproj" />
    <ProjectReference Include="..\Aion2Assistant.Timers\Aion2Assistant.Timers.csproj" />
    <ProjectReference Include="..\Aion2Assistant.Capture\Aion2Assistant.Capture.csproj" />
    <ProjectReference Include="..\Aion2Assistant.Protocol\Aion2Assistant.Protocol.csproj" />
    <ProjectReference Include="..\Aion2Assistant.Combat\Aion2Assistant.Combat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml devient une simple Page : le Main généré est remplacé par celui de App.xaml.cs. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="timers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="themes\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="legal\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
