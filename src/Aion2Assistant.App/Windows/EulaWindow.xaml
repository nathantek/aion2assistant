<Window x:Class="Aion2Assistant.App.Windows.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Aion2Assistant.App.Localization"
        Title="{loc:Tr EulaTitle}" Width="560" Height="520"
        Topmost="True" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource FontSizeNormal}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="EulaText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource OverlayBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource DividerBrush}" Padding="10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AcceptButton" Style="{StaticResource TextButtonStyle}" Content="{loc:Tr EulaAccept}"
                    Padding="16,6" Click="OnAccept"/>
            <Button x:Name="QuitButton" Style="{StaticResource TextButtonStyle}" Content="{loc:Tr EulaQuit}"
                    Padding="16,6" Margin="0" Click="OnQuit"/>
        </StackPanel>
    </Grid>
</Window>
