<UserControl x:Class="Aion2Assistant.App.Views.ShareCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Aion2Assistant.App.Localization"
             xmlns:ctl="clr-namespace:Aion2Assistant.App.Controls"
             Background="{DynamicResource SolidBackgroundBrush}"
             FontFamily="{DynamicResource UiFont}">
    <!-- Carte rendue hors écran pour la copie en image : pas de ScrollViewer, toutes les lignes. DataContext = MeterViewModel. -->
    <StackPanel Margin="10">
        <DockPanel>
            <ContentControl DockPanel.Dock="Right" Content="{Binding Badge}" Focusable="False" Margin="6,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}"/>
            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock Text="{Binding TargetHpText}" Style="{StaticResource SmallValueStyle}" HorizontalAlignment="Right"
                   Margin="0,2,0,0"
                   Visibility="{Binding HasTargetHpText, Converter={StaticResource BoolToVisibility}}"/>
        <ProgressBar Style="{StaticResource ThinProgressStyle}" Height="3" Minimum="0" Maximum="100"
                     Value="{Binding TargetHpPct, Mode=OneWay, TargetNullValue=0}" Foreground="{Binding Accent}"
                     Margin="0,3,0,0"
                     Visibility="{Binding HasTargetHp, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Liste -->
        <StackPanel Margin="0,4,0,0" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding GroupText}" Style="{StaticResource SmallValueStyle}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MeterRowTemplate}"/>
        </StackPanel>

        <!-- Courbe -->
        <StackPanel Margin="0,4,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChart}" Value="True"/>
                                <Condition Binding="{Binding HasChartData}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ctl:DpsChart Height="160" Series="{Binding ChartSeries}" DurationMs="{Binding ChartDurationMs}"/>
            <ItemsControl ItemsSource="{Binding ChartSeries}" Margin="0,4,0,0"
                          ItemTemplate="{StaticResource ChartLegendItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <TextBlock Text="{loc:Tr MeterNoChart}"
                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" Margin="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChart}" Value="True"/>
                                <Condition Binding="{Binding HasChartData}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Détail -->
        <StackPanel Margin="0,4,0,0" Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding DetailName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SkillHeaderTemplate}"/>
            <ItemsControl ItemsSource="{Binding DetailSkills}" ItemTemplate="{StaticResource SkillLineTemplate}"/>
            <StackPanel Visibility="{Binding ShowRecaps, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:Tr MeterDeathRecap}" Style="{StaticResource SectionHeaderStyle}"/>
                <ItemsControl ItemsSource="{Binding DetailRecaps}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Aion2Assistant" HorizontalAlignment="Right" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
    </StackPanel>
</UserControl>
