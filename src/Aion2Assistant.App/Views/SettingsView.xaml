<UserControl x:Class="Aion2Assistant.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aion2Assistant.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="AFFICHAGE"/>
            <TextBlock Text="{Binding UiScale, StringFormat='Échelle de l’interface : {0:P0}'}"/>
            <Slider Minimum="0.8" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding UiScale}"/>
            <TextBlock Text="{Binding FontScale, StringFormat='Taille du texte : {0:P0}'}" Margin="0,6,0,0"/>
            <Slider Minimum="0.8" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding FontScale}"/>
            <TextBlock Text="{Binding Opacity, StringFormat='Opacité du fond : {0:P0}'}" Margin="0,6,0,0"/>
            <Slider Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.1" IsSnapToTickEnabled="True" Value="{Binding Opacity}"/>
            <TextBlock Text="Sous 90 % d'opacité, le texte est détouré pour rester lisible."
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                       TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding ShowOutlineHint, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="Thème" Margin="0,6,0,0"/>
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Visibility="{Binding SelectedThemeHasGlow, Converter={StaticResource BoolToVisibility}}">
                <CheckBox Content="Effets lumineux" IsChecked="{Binding GlowEnabled}" Margin="0,6,0,0"/>
                <TextBlock Text="Lueur du texte pour les thèmes qui en ont une. Désactiver si l'app ralentit."
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource TextButtonStyle}" Content="Réinitialiser la position"
                    Command="{Binding ResetPositionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="SON"/>
            <TextBlock Text="{Binding Volume, StringFormat='Volume : {0:P0}'}"/>
            <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Volume}"/>
            <TextBlock Text="{Binding SoundLabel}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TextButtonStyle}" Content="Choisir un .wav…" Command="{Binding ChooseSoundCommand}"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="Par défaut" Command="{Binding ResetSoundCommand}"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="Tester" Command="{Binding TestSoundCommand}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="TIMERS"/>
            <ItemsControl ItemsSource="{Binding Timers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TimerSettingRowViewModel}">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <WrapPanel>
                                <CheckBox Content="Afficher" IsChecked="{Binding Visible}" Margin="0,2,10,2"/>
                                <CheckBox Content="Notifier" IsChecked="{Binding Notify}" Margin="0,2,10,2"/>
                                <CheckBox Content="Son" IsChecked="{Binding Sound}" Margin="0,2,10,2"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Prévenir" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE738;"
                                            Command="{Binding DecreaseThresholdCommand}" ToolTip="Moins tôt"/>
                                    <TextBlock Text="{Binding ThresholdText}" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;"
                                            Command="{Binding IncreaseThresholdCommand}" ToolTip="Plus tôt"/>
                                    <TextBlock Text="avant" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="COMBAT"/>
            <TextBlock Text="{Binding CombatIdleSeconds, StringFormat='Fin de combat après inactivité : {0:0} s'}"/>
            <Slider Minimum="3" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CombatIdleSeconds}"/>
            <CheckBox Content="Inclure tous les joueurs (sinon : moi seulement)" IsChecked="{Binding IncludeAllPlayers}" Margin="0,6,0,0"/>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="CAPTURE"/>
            <StackPanel DataContext="{Binding Capture}">
                <DockPanel>
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding IndicatorBrush}"/>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{Binding SelfText, StringFormat='Personnage : {0}'}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Adapter, StringFormat='Carte : {0}'}" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Server, StringFormat='Serveur : {0}'}" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CountersText}" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <ItemsControl ItemsSource="{Binding TopOpcodes}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Style="{StaticResource TextButtonStyle}" Content="{Binding RecordButtonText}"
                            Command="{Binding ToggleRecordingCommand}"/>
                    <Button Style="{StaticResource TextButtonStyle}" Content="Ouvrir le dossier"
                            Command="{Binding OpenCapturesFolderCommand}"/>
                </StackPanel>
                <TextBlock Text="Les captures et les logs contiennent ton pseudo, ton serveur et le chat du jeu : ne les publie pas (issue GitHub, Discord public), envoie-les en privé."
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="RACCOURCIS"/>
            <ItemsControl ItemsSource="{Binding Hotkeys}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HotkeyRowViewModel}">
                        <StackPanel Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource TextButtonStyle}" Margin="0"
                                        Content="{Binding DisplayText}" Command="{Binding BeginCaptureCommand}"
                                        ToolTip="Cliquer puis appuyer sur la nouvelle combinaison"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource AlertBrush}"
                                       FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"
                                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="À PROPOS"/>
            <TextBlock Text="{Binding VersionText}"/>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButtonStyle}" Margin="0" Content="Voir"
                        Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/nathantek/aion2assistant/blob/main/LICENSE"/>
                <TextBlock Text="Licence : GPL-3.0" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButtonStyle}" Margin="0" Content="Voir"
                        Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/nathantek/aion2assistant/blob/main/data/NOTICE.md"/>
                <TextBlock Text="Données de jeu : © NCSOFT" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Style="{StaticResource TextButtonStyle}" Content="Site"
                        Command="{Binding OpenLinkCommand}" CommandParameter="https://nathantek.github.io/aion2assistant/"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="Dépôt"
                        Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/nathantek/aion2assistant"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="Lire le CLUF" Command="{Binding ReadEulaCommand}"/>
            </StackPanel>
            <DockPanel Margin="0,6,0,0" Visibility="{Binding UpdateStatusText, Converter={StaticResource NullToCollapsed}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButtonStyle}" Margin="0" Content="Télécharger"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding OpenLinkCommand}" CommandParameter="{Binding UpdateUrl}"/>
                <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center"/>
            </DockPanel>
            <CheckBox Content="Vérifier les mises à jour au démarrage" IsChecked="{Binding CheckForUpdates}" Margin="0,6,0,0"/>
            <TextBlock Text="L'app contacte GitHub uniquement pour connaître la dernière version. Aucune autre donnée n'est envoyée."
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
