<UserControl x:Class="Aion2Assistant.App.Views.MeterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Aion2Assistant.App.Localization"
             xmlns:vm="clr-namespace:Aion2Assistant.App.ViewModels"
             xmlns:ctl="clr-namespace:Aion2Assistant.App.Controls">
    <UserControl.Resources>
        <!-- Bouton courbe / classement : glyphe liste quand la courbe est affichée -->
        <Style x:Key="ChartToggleStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Content" Value="&#xE9D2;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChart}" Value="True">
                    <Setter Property="Content" Value="&#xE8FD;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Entraînement : ligne d'état, hors du bloc combat pour rester utilisable sans combat -->
        <StackPanel>
            <DockPanel Margin="0,0,0,4" Visibility="{Binding HasTrainingText, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButtonStyle}" Content="{loc:Tr TrainingStop}" Margin="6,0,0,0"
                        Command="{Binding StopTrainingCommand}"/>
                <TextBlock Text="{Binding TrainingText}" Foreground="{DynamicResource AlertBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
        <!-- Aucun combat -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                    Visibility="{Binding HasSnapshot, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="{loc:Tr MeterNoFight}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasLastFight, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Tr MeterLastFight}"/>
                <TextBlock Text="{Binding LastFightText}" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" TextTrimming="CharacterEllipsis"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="{loc:Tr MeterOpenInHistory}" HorizontalAlignment="Left"
                        Command="{Binding OpenLastFightClickCommand}"/>
            </StackPanel>
        </StackPanel>

        <Grid Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Margin="0,0,0,4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChartToggleStyle}" Margin="6,0,0,0"
                            Command="{Binding ToggleChartCommand}" ToolTip="{loc:Tr MeterChartToggleTip}"
                            Visibility="{Binding ShowChartToggle, Converter={StaticResource BoolToVisibility}}"/>
                    <Border DockPanel.Dock="Right" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowBossToggle, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButtonStyle}" Content="{loc:Tr MeterBossOnly}"
                                         IsChecked="{Binding IsBossOnly, Mode=OneWay}"
                                         Command="{Binding SetBossOnlyCommand}" CommandParameter="True"
                                         ToolTip="{loc:Tr MeterBossOnlyTip}">
                                <RadioButton.Tag><CornerRadius>4,0,0,4</CornerRadius></RadioButton.Tag>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentButtonStyle}" Content="{loc:Tr MeterAll}"
                                         IsChecked="{Binding IsAll, Mode=OneWay}"
                                         Command="{Binding SetBossOnlyCommand}" CommandParameter="False"
                                         ToolTip="{loc:Tr MeterAllTip}">
                                <RadioButton.Tag><CornerRadius>0,4,4,0</CornerRadius></RadioButton.Tag>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <ContentControl DockPanel.Dock="Right" Content="{Binding Badge}" Focusable="False" Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource ThinProgressStyle}" Height="3" Minimum="0" Maximum="100"
                             Value="{Binding TargetHpPct, Mode=OneWay, TargetNullValue=0}" Foreground="{Binding Accent}"
                             Margin="0,3,0,0"
                             Visibility="{Binding HasTargetHp, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Liste -->
            <Grid Grid.Row="1" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding GroupText}" Style="{StaticResource SmallValueStyle}" Margin="0,0,0,4"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MeterRowTemplate}"/>
                </ScrollViewer>
            </Grid>

            <!-- Courbe -->
            <Grid Grid.Row="1" Visibility="{Binding IsChart, Converter={StaticResource BoolToVisibility}}">
                <Grid Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ctl:DpsChart Series="{Binding ChartSeries}" DurationMs="{Binding ChartDurationMs}"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ChartSeries}" Margin="0,4,0,0"
                                  ItemTemplate="{StaticResource ChartLegendItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
                <TextBlock Text="{loc:Tr MeterNoChart}"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                           Visibility="{Binding HasChartData, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>

            <!-- Détail -->
            <Grid Grid.Row="1" Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Left" Style="{StaticResource TextButtonStyle}" Content="{loc:Tr Back}"
                            Command="{Binding BackCommand}"/>
                    <TextBlock Text="{Binding DetailName}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource SkillHeaderTemplate}"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding DetailSkills}" ItemTemplate="{StaticResource SkillLineTemplate}"/>
                        <StackPanel Visibility="{Binding ShowRecaps, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Tr MeterDeathRecap}" Style="{StaticResource SectionHeaderStyle}"/>
                            <ItemsControl ItemsSource="{Binding DetailRecaps}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>

        <!-- Barre d'actions : bande d'entraînement au-dessus ; Entraînement à gauche, Copier à droite -->
        <StackPanel Grid.Row="2" Margin="0,6,0,0"
                    Visibility="{Binding ShowActionBar, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel Margin="0,0,0,4"
                        Visibility="{Binding IsTrainingStripOpen, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource TextButtonStyle}" Content="1 min" Margin="0,0,6,0"
                        Command="{Binding StartTrainingCommand}" CommandParameter="60000"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="3 min" Margin="0,0,6,0"
                        Command="{Binding StartTrainingCommand}" CommandParameter="180000"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="5 min" Margin="0,0,6,0"
                        Command="{Binding StartTrainingCommand}" CommandParameter="300000"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="{loc:Tr TrainingFree}" Margin="0,0,6,0"
                        Command="{Binding StartTrainingCommand}" CommandParameter="0"/>
                <Button Style="{StaticResource TextButtonStyle}" Content="{loc:Tr Cancel}"
                        Command="{Binding ToggleTrainingStripCommand}"/>
            </WrapPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource TextButtonStyle}" Padding="6,4" Margin="0"
                        Command="{Binding ToggleTrainingStripCommand}" ToolTip="{loc:Tr TrainingTip}"
                        Visibility="{Binding ShowTrainingButton, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE916;" FontFamily="{DynamicResource IconFont}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr Training}" FontSize="{DynamicResource FontSizeSmall}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>
                <Grid Grid.Column="1" Margin="6,0,0,0" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource TextButtonStyle}" Margin="0,0,3,0" Padding="6,4"
                            Command="{Binding CopyCommand}"
                            ToolTip="{loc:Tr CopyTextTip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CopyTextLabel}" FontSize="{DynamicResource FontSizeSmall}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource TextButtonStyle}" Margin="3,0,0,0" Padding="6,4"
                            Command="{Binding CopyImageCommand}"
                            ToolTip="{loc:Tr CopyImageTip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE722;" FontFamily="{DynamicResource IconFont}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CopyImageLabel}" FontSize="{DynamicResource FontSizeSmall}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
