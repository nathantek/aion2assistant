<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Aion2Assistant.App.Localization"
                    xmlns:vm="clr-namespace:Aion2Assistant.App.ViewModels"
                    xmlns:conv="clr-namespace:Aion2Assistant.App.Converters"
                    xmlns:combat="clr-namespace:Aion2Assistant.Combat;assembly=Aion2Assistant.Combat">
    <!-- Gabarits partagés par MeterView et ShareCardView (image du tableau) -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <conv:ClassIconConverter x:Key="ClassIconConverter"/>
    <Style x:Key="SmallMutedStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="SmallValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SmallMutedStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Légende d'une série (autonome : déplaçable telle quelle dans un ResourceDictionary partagé) -->
    <DataTemplate x:Key="ChartLegendItemTemplate" DataType="{x:Type vm:ChartSeries}">
        <!-- Vrai Button : un InputBinding ne résout pas son Command depuis un dictionnaire applicatif -->
        <Button Margin="0,0,10,2" ToolTip="{loc:Tr MeterChartLegendTip}"
                Command="{Binding DataContext.ToggleSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource RowButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
            <Rectangle Width="8" Height="8" Stroke="{Binding Brush}" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,4,0">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{Binding Brush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter Property="Fill" Value="Transparent"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </StackPanel>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="MeterRowTemplate" DataType="{x:Type vm:MeterRowViewModel}">
        <Button Style="{StaticResource RowButtonStyle}" Margin="0,1" Height="22"
                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
        <Grid>
            <ProgressBar Style="{StaticResource ThinProgressStyle}" Height="Auto" Minimum="0" Maximum="1"
                         Background="Transparent" Foreground="{Binding ClassBrush}"
                         Opacity="0.35"
                         Value="{Binding BarFraction, Mode=OneWay}" IsHitTestVisible="False"/>
            <Grid Margin="4,0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Icône de classe (pas de couleur propre : brosse du nom). Absente du texte copié pour le chat.
                         Dessinée dans sa boîte 24×24 (Stretch None) puis réduite à 16 px par le Viewbox : toutes les icônes
                         gardent la même échelle et leur position dans la boîte, même celles qui n'occupent qu'une partie. -->
                    <Viewbox Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Path Width="24" Height="24" Stretch="None"
                              Data="{Binding Class, Converter={StaticResource ClassIconConverter}}"
                              Fill="{Binding ClassBrush}" SnapsToDevicePixels="True"/>
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{Binding ClassBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding CombatPowerText, Mode=OneWay}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="Normal" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding DeathsText}" Foreground="{DynamicResource AlertBrush}"
                               FontSize="{DynamicResource FontSizeSmall}" Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding PerSecondText}" Typography.NumeralAlignment="Tabular"
                           Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"
                           Visibility="{Binding DataContext.ShowPerSecond, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalText}" Style="{StaticResource SmallValueStyle}"
                           Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="{Binding ShareText}" Style="{StaticResource SmallValueStyle}"
                           Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
            </Grid>
        </Grid>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="SkillLineTemplate" DataType="{x:Type vm:SkillLineViewModel}">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeSmall}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="{DynamicResource FontSizeSmall}"
                       Typography.NumeralAlignment="Tabular" TextAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="{Binding ShareText}" Style="{StaticResource SmallValueStyle}"
                       TextAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="{Binding HitsText}" Style="{StaticResource SmallValueStyle}"
                       TextAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="{Binding CritText}" Foreground="{DynamicResource CritBrush}"
                       FontSize="{DynamicResource FontSizeSmall}" Typography.NumeralAlignment="Tabular"
                       TextAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="{Binding MaxText}" Style="{StaticResource SmallValueStyle}"
                       TextAlignment="Right"/>
            <TextBlock Grid.Column="6" Text="{Binding OverhealText}" Style="{StaticResource SmallValueStyle}"
                       TextAlignment="Right" Width="52"
                       Visibility="{Binding DataContext.ShowOverheal, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </DataTemplate>
    <!-- En-tête des colonnes du détail (Content = le MeterViewModel) -->
    <DataTemplate x:Key="SkillHeaderTemplate">
        <Grid Margin="0,0,0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{loc:Tr ColumnSkill}" Style="{StaticResource SmallMutedStyle}"/>
        <TextBlock Grid.Column="1" Text="{loc:Tr ColumnTotal}" Style="{StaticResource SmallMutedStyle}" TextAlignment="Right"/>
        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource SmallMutedStyle}" TextAlignment="Right"/>
        <TextBlock Grid.Column="3" Text="{loc:Tr ColumnHits}" Style="{StaticResource SmallMutedStyle}" TextAlignment="Right"/>
        <TextBlock Grid.Column="4" Text="{loc:Tr ColumnCrit}" Style="{StaticResource SmallMutedStyle}" TextAlignment="Right"/>
        <TextBlock Grid.Column="5" Text="{loc:Tr ColumnMax}" Style="{StaticResource SmallMutedStyle}" TextAlignment="Right"/>
        <TextBlock Grid.Column="6" Text="{loc:Tr ColumnOverheal}" Style="{StaticResource SmallMutedStyle}" TextAlignment="Right"
                   Width="52" Visibility="{Binding ShowOverheal, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecapHeaderViewModel}">
        <TextBlock Text="{Binding Text}" Style="{StaticResource SmallMutedStyle}" Margin="0,6,0,2"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecapLineViewModel}">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TimeText}" Style="{StaticResource SmallMutedStyle}"/>
            <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{Binding Brush}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Source, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Skill, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="{Binding Brush}"
                       FontSize="{DynamicResource FontSizeSmall}" Typography.NumeralAlignment="Tabular"
                       Margin="6,0,0,0"/>
        </Grid>
    </DataTemplate>
    <!-- Badge d'issue (cartes de l'historique et titre du détail) : fond = brosse du ton à faible opacité, jamais
         une brosse d'application modifiée. -->
    <DataTemplate DataType="{x:Type combat:OutcomeBadge}">
        <Grid VerticalAlignment="Center">
            <Border x:Name="Tint" CornerRadius="3" Background="{DynamicResource TextMutedBrush}" Opacity="0.16"/>
            <TextBlock x:Name="Label" Text="{Binding Text}" Margin="6,1" FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}"
                       Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static combat:OutcomeTone.Kill}">
                <Setter TargetName="Tint" Property="Background" Value="{DynamicResource HealBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource HealBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static combat:OutcomeTone.Wipe}">
                <Setter TargetName="Tint" Property="Background" Value="{DynamicResource AlertBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AlertBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static combat:OutcomeTone.Training}">
                <Setter TargetName="Tint" Property="Background" Value="{DynamicResource TakenBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TakenBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
