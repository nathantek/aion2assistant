<UserControl x:Class="Aion2Assistant.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Aion2Assistant.App.Localization"
             xmlns:vm="clr-namespace:Aion2Assistant.App.ViewModels"
             xmlns:views="clr-namespace:Aion2Assistant.App.Views"
             xmlns:combat="clr-namespace:Aion2Assistant.Combat;assembly=Aion2Assistant.Combat"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="MeterTabStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Liste -->
        <Grid Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:Tr HistoryEmpty}" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
            <DockPanel>
                <!-- Filtres : puces (une seule active) puis recherche ; « Comparer (2) » à droite de la recherche -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,2"
                            Visibility="{Binding ShowFilters, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ChipButtonStyle}" Content="{loc:Tr HistoryFilterAll}"
                                     IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static combat:HistoryFilter.All}}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static combat:HistoryFilter.All}"/>
                        <RadioButton Style="{StaticResource ChipButtonStyle}" Content="{loc:Tr HistoryFilterBoss}"
                                     IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static combat:HistoryFilter.Boss}}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static combat:HistoryFilter.Boss}"/>
                        <RadioButton Style="{StaticResource ChipButtonStyle}" Content="{loc:Tr HistoryFilterRecords}"
                                     IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static combat:HistoryFilter.Records}}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static combat:HistoryFilter.Records}"/>
                        <RadioButton Style="{StaticResource ChipButtonStyle}" Content="{loc:Tr Training}"
                                     IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static combat:HistoryFilter.Training}}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="{x:Static combat:HistoryFilter.Training}"/>
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}" Tag="{loc:Tr HistorySearchHint}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewMouseLeftButtonDown="OnSearchMouseDown" PreviewKeyDown="OnSearchKeyDown"
                                 LostKeyboardFocus="OnSearchLostFocus"/>
                        <Button Grid.Column="1" Style="{StaticResource TextButtonStyle}" Content="{loc:Tr HistoryCompareTwo}"
                                Margin="6,0,0,0" Command="{Binding CompareCommand}"
                                Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </StackPanel>
                <Grid>
                    <TextBlock Text="{loc:Tr HistoryNoMatch}" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12"
                               Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVisibility}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type vm:HistoryDayHeaderViewModel}">
                                    <Grid Margin="0,8,0,4" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource SectionHeaderStyle}"
                                                   FontWeight="Normal" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                                    <Button Style="{StaticResource CardButtonStyle}"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Ligne 1 : trophée, boss, badge d'issue -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🏆" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="{loc:Tr HistoryRecordTip}"
                                                           Visibility="{Binding IsRecord, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Boss}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <ContentControl Grid.Column="2" Content="{Binding Badge}" Focusable="False"
                                                                Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <!-- Ligne 2 : heure · durée … DPS du groupe (case « Comparer » en entraînement) -->
                                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeDurationText}" Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="{DynamicResource FontSizeSmall}" Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding GroupText}" Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="{DynamicResource FontSizeSmall}" Typography.NumeralAlignment="Tabular"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsNotTraining, Converter={StaticResource BoolToVisibility}}"/>
                                                <CheckBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsCompareChecked}"
                                                          Visibility="{Binding IsTraining, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- TextBlock explicite : le style implicite imposerait la taille normale -->
                                                    <TextBlock Text="{loc:Tr HistoryCompare}" FontSize="{DynamicResource FontSizeSmall}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </CheckBox>
                                            </Grid>
                                            <!-- Ligne 3 : toi … rang et part (écart avec l'essai précédent en entraînement) -->
                                            <Grid Grid.Row="2" Margin="0,3,0,0"
                                                  Visibility="{Binding HasSelf, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelfText}" Foreground="{DynamicResource DpsBrush}" FontWeight="SemiBold"
                                                           Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RightText}" FontSize="{DynamicResource FontSizeSmall}"
                                                           Typography.NumeralAlignment="Tabular" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeltaSign}" Value="1">
                                                                    <Setter Property="Foreground" Value="{DynamicResource HealBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DeltaSign}" Value="-1">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AlertBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <!-- Part du DPS du groupe -->
                                            <ProgressBar Grid.Row="3" Style="{StaticResource ThinProgressStyle}" Margin="0,4,0,0"
                                                         Minimum="0" Maximum="1" Value="{Binding ShareFraction, Mode=OneWay}"
                                                         Foreground="{DynamicResource DpsBrush}"
                                                         Visibility="{Binding ShowShareBar, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Comparaison de deux essais -->
        <views:ComparisonView DataContext="{Binding Comparison}"
                              Visibility="{Binding DataContext.IsComparing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Détail -->
        <DockPanel Visibility="{Binding IsDetail, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Style="{StaticResource TextButtonStyle}" Content="{loc:Tr Back}" Command="{Binding BackCommand}"/>
                <Button Content="{loc:Tr TabDps}" Command="{Binding ShowMeterCommand}" CommandParameter="{Binding Dps}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MeterTabStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMeter.Kind}" Value="Dps">
                                    <Setter Property="Foreground" Value="{DynamicResource DpsBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{loc:Tr TabHeal}" Command="{Binding ShowMeterCommand}" CommandParameter="{Binding Heal}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MeterTabStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMeter.Kind}" Value="Heal">
                                    <Setter Property="Foreground" Value="{DynamicResource HealBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{loc:Tr HistoryTaken}" Command="{Binding ShowMeterCommand}" CommandParameter="{Binding Taken}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MeterTabStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMeter.Kind}" Value="Taken">
                                    <Setter Property="Foreground" Value="{DynamicResource TakenBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding DetailMessage}" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,8" Visibility="{Binding DetailMessage, Converter={StaticResource NullToCollapsed}}"/>
            <ContentControl Content="{Binding SelectedMeter}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetailMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DockPanel>
    </Grid>
</UserControl>
