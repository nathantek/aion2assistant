<UserControl x:Class="Aion2Assistant.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aion2Assistant.App.ViewModels"
             xmlns:views="clr-namespace:Aion2Assistant.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="MeterTabStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Liste -->
        <Grid Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Aucun combat enregistré." Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
            <DockPanel>
            <Button DockPanel.Dock="Top" Style="{StaticResource TextButtonStyle}" Content="Comparer (2)" HorizontalAlignment="Left"
                    Margin="0,0,0,4" Command="{Binding CompareCommand}"
                    Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:HistoryDayHeaderViewModel}">
                            <TextBlock Text="{Binding Text}" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                            <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Comparer" VerticalAlignment="Center" Margin="6,0,0,0"
                                      FontSize="{DynamicResource FontSizeSmall}" IsChecked="{Binding IsCompareChecked}"
                                      Visibility="{Binding IsTraining, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource TextButtonStyle}" Margin="0,1" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextMutedBrush}"
                                               Typography.NumeralAlignment="Tabular" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BossText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DpsText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DpsBrush}" Typography.NumeralAlignment="Tabular"
                                               Margin="8,0,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                                               Typography.NumeralAlignment="Tabular">
                                        <Run Text="{Binding Zone, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DurationText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding OutcomeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Comparaison de deux essais -->
        <views:ComparisonView DataContext="{Binding Comparison}"
                              Visibility="{Binding DataContext.IsComparing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Détail -->
        <DockPanel Visibility="{Binding IsDetail, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Style="{StaticResource TextButtonStyle}" Content="‹ Retour" Command="{Binding BackCommand}"/>
                <Button Content="DPS" Command="{Binding ShowMeterCommand}" CommandParameter="{Binding Dps}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MeterTabStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMeter.Kind}" Value="Dps">
                                    <Setter Property="Foreground" Value="{DynamicResource DpsBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Soins" Command="{Binding ShowMeterCommand}" CommandParameter="{Binding Heal}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MeterTabStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMeter.Kind}" Value="Heal">
                                    <Setter Property="Foreground" Value="{DynamicResource HealBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Reçus" Command="{Binding ShowMeterCommand}" CommandParameter="{Binding Taken}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MeterTabStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMeter.Kind}" Value="Taken">
                                    <Setter Property="Foreground" Value="{DynamicResource TakenBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding DetailMessage}" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,8" Visibility="{Binding DetailMessage, Converter={StaticResource NullToCollapsed}}"/>
            <ContentControl Content="{Binding SelectedMeter}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetailMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DockPanel>
    </Grid>
</UserControl>
