<UserControl x:Class="Aion2Assistant.App.Views.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Aion2Assistant.App.Localization"
             xmlns:vm="clr-namespace:Aion2Assistant.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HasDataToVisibility"/>
        <!-- Δ : vert si positif, rouge si négatif, atténué si nul ou absent (brosses de thème, relues par DynamicResource). -->
        <Style x:Key="DeltaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Sign}" Value="1">
                    <Setter Property="Foreground" Value="{DynamicResource HealBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Sign}" Value="-1">
                    <Setter Property="Foreground" Value="{DynamicResource DpsBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <DataTemplate x:Key="LineTemplate" DataType="{x:Type vm:ComparisonLine}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding A}" Style="{StaticResource ValueStyle}"/>
                <TextBlock Grid.Column="2" Text="{Binding B}" Style="{StaticResource ValueStyle}"/>
                <TextBlock Grid.Column="3" Text="{Binding Delta}" Style="{StaticResource DeltaStyle}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Button DockPanel.Dock="Top" Style="{StaticResource TextButtonStyle}" Content="{loc:Tr Back}" HorizontalAlignment="Left"
                Margin="0,0,0,6" Command="{Binding BackCommand}"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8"
                   Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasData, Converter={StaticResource HasDataToVisibility}}">
            <StackPanel>
                <!-- En-têtes : un par essai -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="A" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="{Binding HeaderA}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="B" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="{Binding HeaderB}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LineTemplate}"/>
                <!-- Tableau des compétences -->
                <Grid Margin="0,10,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Tr ComparisonSkill}" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="1" Text="A" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="B" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="Δ" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Skills}" ItemTemplate="{StaticResource LineTemplate}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
