<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="DpsBrush" Color="#FF5A36"/>
    <SolidColorBrush x:Key="HealBrush" Color="#2BD67B"/>
    <SolidColorBrush x:Key="TakenBrush" Color="#A66BFF"/>
    <SolidColorBrush x:Key="TimerBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="AlertBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="CritBrush" Color="#FFE14D"/>

    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8B93A1"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1F26"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#262B34"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2F38"/>
    <!-- Remplacé au démarrage par ThemeManager selon l'opacité choisie. -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#E6121418"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Tailles de base, multipliées par l'échelle de police par ThemeManager. -->
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeHuge">22</sys:Double>
</ResourceDictionary>
